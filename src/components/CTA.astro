---
interface Props {
  id?: string;
  heading: string;
  text: string;
}

const { id, heading, text } = Astro.props;
---

<section class="section cta" id={id}>
  <div class="container">
    <div class="cta-panel">
      <h2>{heading}</h2>
      <p>{text}</p>
      <div class="btn-row">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(2rem, 1.5rem + 2.5vw, 3.5rem) clamp(1.25rem, 1rem + 2vw, 3rem);
    border-radius: 1.5rem;
    background: var(--primary);
    color: var(--on-primary);
    box-shadow: var(--shadow-lg);
  }

  .cta-panel h2,
  .cta-panel p {
    color: var(--on-primary);
  }

  .cta-panel p {
    opacity: 0.9;
    margin-bottom: 1.75rem;
  }

  .cta-panel .btn-row {
    justify-content: center;
  }

  .cta-panel :global(.btn--primary) {
    background: var(--on-primary);
    color: var(--primary);
  }

  .cta-panel :global(.btn--primary:hover) {
    background: #ffffff;
    color: var(--primary);
  }

  .cta-panel :global(.btn--ghost) {
    color: var(--on-primary);
    border-color: color-mix(in srgb, var(--on-primary) 45%, transparent);
    background: transparent;
  }

  .cta-panel :global(.btn--ghost:hover) {
    color: var(--on-primary);
    border-color: var(--on-primary);
  }
</style>
