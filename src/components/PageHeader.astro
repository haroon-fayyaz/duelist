---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
}

const { eyebrow, title, lead, id = 'page-title' } = Astro.props;
---

<header class="page-header">
  <div class="container">
    <div class="page-header-inner">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 id={id}>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2rem, 1.5rem + 2vw, 3rem);
    background:
      radial-gradient(50rem 22rem at 15% -10%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 70%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .page-header-inner {
    max-width: 46rem;
  }

  .page-header h1 {
    margin-bottom: 0.75rem;
  }
</style>
