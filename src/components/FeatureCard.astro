---
interface Props {
  title: string;
  /** Inline SVG markup for the icon (24px outline, currentColor). */
  icon: string;
}

const { title, icon } = Astro.props;
---

<article class="card feature-card">
  <span class="icon-badge" aria-hidden="true" set:html={icon}></span>
  <h3>{title}</h3>
  <p><slot /></p>
</article>

<style>
  .feature-card {
    height: 100%;
    transition: box-shadow 0.25s var(--ease), border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .feature-card:hover {
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--primary) 35%, var(--border));
    transform: translateY(-2px);
  }

  .feature-card :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card:hover {
      transform: none;
    }
  }
</style>
