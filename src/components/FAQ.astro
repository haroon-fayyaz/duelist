---
export interface FaqItem {
  question: string;
  /** Answer as plain HTML-safe text or simple inline HTML. */
  answer: string;
}

interface Props {
  items: FaqItem[];
  /** Optional id prefix so several FAQ groups can live on one page. */
  idPrefix?: string;
}

const { items, idPrefix = 'faq' } = Astro.props;
---

<div class="faq">
  {items.map((item, index) => (
    <details id={`${idPrefix}-${index + 1}`} class="faq-item">
      <summary>
        <span>{item.question}</span>
        <span class="faq-icon" aria-hidden="true"></span>
      </summary>
      <div class="faq-body">
        <p set:html={item.answer} />
      </div>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s var(--ease);
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--primary) 40%, var(--border));
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 1rem 1.25rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-md);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--bg-elevated);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.65rem;
    height: 2px;
    border-radius: 2px;
    background: var(--primary);
    transform: translate(-50%, -50%);
    transition: transform 0.25s var(--ease);
  }

  .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-body {
    padding: 0 1.25rem 1.25rem;
  }

  .faq-body p {
    margin: 0 0 0.75em;
    max-width: 62ch;
  }

  .faq-body p:last-child {
    margin-bottom: 0;
  }

  .faq-body :global(a) {
    font-weight: 500;
  }

  .faq-item summary:focus-visible {
    outline-offset: -3px;
  }
</style>
