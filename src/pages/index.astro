---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTA from '../components/CTA.astro';

const icons = {
  currency: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v10H3z"/><circle cx="12" cy="12" r="2.5"/><path d="M7 12h.01M17 12h.01"/></svg>',
  bell: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>',
  timer: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9.5 2.5h5"/></svg>',
  calendar: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
  shield: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>',
  download: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>',
  widget: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="18" height="8" rx="2"/></svg>',
  globe: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/></svg>',
  wallet: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M16 15h2"/></svg>',
  pause: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg>',
  eye: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>',
};

const features = [
  {
    title: 'Totals per currency',
    icon: icons.currency,
    text: 'Monthly and yearly totals are kept separate for each currency, including PKR. Amounts are never converted unless you enter your own rates or turn on live rates.',
  },
  {
    title: 'Renewal reminders',
    icon: icons.bell,
    text: 'Choose how many days before a renewal you want a reminder, from 0 to 30, and the time of day it is sent. Reminders are scheduled on your phone.',
  },
  {
    title: 'Free trial tracking',
    icon: icons.timer,
    text: 'Flag a trial and get a reminder the day before it ends and again on the day it ends, so a trial does not quietly turn into a charge.',
  },
  {
    title: 'Renewing this week',
    icon: icons.eye,
    text: 'See what renews in the next seven days and a dues forecast, so you know what is coming before it hits your account.',
  },
  {
    title: 'Calendar export',
    icon: icons.calendar,
    text: 'Export your renewals as an .ics file and import it into the calendar app you already use. The file is shared only where you choose.',
  },
  {
    title: 'Plain JSON backup',
    icon: icons.download,
    text: 'Back up your list to a file and restore it on another phone. The backup is plain JSON and is not encrypted, and the app says so before you save it.',
  },
  {
    title: 'Payment method labels',
    icon: icons.wallet,
    text: 'Label each item as card, bank transfer, mobile wallet, carrier balance, cash, or other, so the list matches how you actually pay.',
  },
  {
    title: 'Cancel and reactivate',
    icon: icons.pause,
    text: 'Mark a subscription as cancelled when you have stopped it, keep its record, and reactivate it later if you change your mind.',
  },
  {
    title: 'Widget, lock, and themes',
    icon: icons.widget,
    text: 'A home-screen widget, biometric lock using your phone’s own fingerprint or face unlock, hide-in-recents, and light and dark themes.',
  },
  {
    title: 'English and Urdu',
    icon: icons.globe,
    text: 'The app includes an Urdu translation alongside English.',
  },
];

const steps = [
  {
    title: 'Add what renews',
    text: 'Enter a name, the amount, the currency, the billing cycle, and the next renewal date. Mark a free trial if there is one.',
  },
  {
    title: 'Set your reminders',
    text: 'Pick how many days before renewal you want a reminder and the time of day. The default is 3 days before at 09:00.',
  },
  {
    title: 'Review the overview',
    text: 'The overview shows monthly and yearly totals for each currency and what renews this week, so there are no surprises.',
  },
];
---

<MainLayout
  title="Renewal Keeper: subscription and bill reminders, offline"
  description="Track subscriptions, bills, and free trials on your phone. Monthly and yearly totals per currency, including PKR. No account, no bank access, and your list is never sent to us."
>
  <Hero />

  <section class="section section--alt" id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Features</p>
        <h2 id="features-title">Everything a renewal list needs, nothing that reads your bank.</h2>
        <p>Built for people with a handful of recurring charges who want reminders without handing over an account.</p>
      </div>
      <div class="features-grid">
        {features.map((feature) => (
          <FeatureCard title={feature.title} icon={feature.icon}>{feature.text}</FeatureCard>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works" aria-labelledby="how-title">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">Three steps to your first reminder.</h2>
      </div>
      <ol class="steps">
        {steps.map((step, index) => (
          <li class="step card">
            <span class="step-number" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt" id="showcase" aria-labelledby="showcase-title">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Screens</p>
        <h2 id="showcase-title">Calm and readable, from the first screen.</h2>
        <p>Real screens from the Android app. Amounts are shown exactly as entered, in the currency you chose.</p>
      </div>
      <div class="showcase-grid">
        <figure class="shot">
          <div class="device">
            <img
              src="/images/overview.png"
              width="720"
              height="1600"
              loading="lazy"
              decoding="async"
              alt="Overview screen with separate PKR, USD, and EUR monthly totals and a trial ending in two days."
            />
          </div>
          <figcaption>
            <strong>Overview</strong>
            Monthly and yearly totals per currency, a trial warning, and what renews this week.
          </figcaption>
        </figure>

        <figure class="shot">
          <div class="device">
            <img
              src="/images/subscriptions.png"
              width="720"
              height="1600"
              loading="lazy"
              decoding="async"
              alt="Subscriptions list showing each item with its amount, cycle, payment method, and next renewal date."
            />
          </div>
          <figcaption>
            <strong>Subscriptions</strong>
            Every item with its price, cycle, payment method, and next renewal date.
          </figcaption>
        </figure>

        <figure class="shot">
          <div class="device">
            <img
              src="/images/settings.png"
              width="720"
              height="1600"
              loading="lazy"
              decoding="async"
              alt="Settings screen with reminder time and lead time, calendar export, backup and restore, and the combined total option."
            />
          </div>
          <figcaption>
            <strong>Settings</strong>
            Reminder timing, calendar export, plain JSON backup, and your data controls.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="benefits" aria-labelledby="benefits-title">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Why Renewal Keeper</p>
        <h2 id="benefits-title">Built around privacy and honest numbers.</h2>
      </div>
      <div class="benefits-grid">
        <article class="card benefit">
          <span class="icon-badge" aria-hidden="true" set:html={icons.shield}></span>
          <h3>Your list stays on your phone</h3>
          <p>The subscription list is stored on this device. There is no account and no sign-in, so there is nothing for us to hold.</p>
        </article>
        <article class="card benefit">
          <span class="icon-badge" aria-hidden="true" set:html={icons.currency}></span>
          <h3>Totals you can trust</h3>
          <p>PKR is never added to USD by accident. A combined total appears only when you provide the rate.</p>
        </article>
        <article class="card benefit">
          <span class="icon-badge" aria-hidden="true" set:html={icons.bell}></span>
          <h3>Reminders before the charge</h3>
          <p>Renewal and trial reminders are scheduled on your phone, with generic lock-screen text. Some phone makers pause background work, so the app also catches up when you open it.</p>
        </article>
        <article class="card benefit">
          <span class="icon-badge" aria-hidden="true" set:html={icons.wallet}></span>
          <h3>No bank login, no ads</h3>
          <p>Renewal Keeper does not connect to your bank, read your SMS or email, or show ads.</p>
        </article>
      </div>
    </div>
  </section>

  <CTA
    id="get-app"
    heading="Start with the first renewal you want to remember."
    text="Renewal Keeper is an Android app. The Google Play link will be added here when the app is available to download."
  >
    <a class="btn btn--primary" href="/support">Get help</a>
    <a class="btn btn--ghost" href="/privacy-policy">Read the privacy policy</a>
  </CTA>
</MainLayout>

<style>
  .features-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .steps li + li {
    margin-top: 0;
  }

  .step {
    position: relative;
  }

  .step-number {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 700;
  }

  .showcase-grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .device {
    width: min(16rem, 100%);
    padding: 0.5rem;
    border-radius: 2rem;
    background: linear-gradient(160deg, #2a3431, #0c100f);
    box-shadow: var(--shadow-lg);
  }

  .device img {
    width: 100%;
    height: auto;
    border-radius: 1.5rem;
    aspect-ratio: 720 / 1600;
    object-fit: cover;
    object-position: top;
  }

  .shot figcaption {
    margin-top: 1.25rem;
    max-width: 22rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .shot figcaption strong {
    display: block;
    color: var(--ink);
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }

  .benefits-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .benefit {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25rem;
    align-items: start;
  }

  .benefit .icon-badge {
    grid-row: span 2;
    margin-bottom: 0;
  }

  .benefit :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 960px) {
    .steps,
    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .showcase-grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }

  @media (min-width: 641px) and (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
